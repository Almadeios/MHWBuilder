{
  "name": "mhwilds-set-search",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.2.5",
    "@mui/icons-material": "^6.4.7",
    "@mui/material": "^6.4.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^13.5.0",
    "electron-updater": "^6.8.9",
    "html-to-image": "^1.11.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "use-debounce": "^10.0.4"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "desktop:build": "vite build --mode desktop && electron-builder --win nsis",
    "desktop:portable": "vite build --mode desktop && electron-builder --win dir",
    "desktop:dev": "vite --mode desktop",
    "benchmark": "node scripts/run-optimizer-benchmarks.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "lint": "eslint src scripts e2e vite.config.mjs playwright.config.mjs --ext .js,.jsx,.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^29.1.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.mhwilds.builder",
    "productName": "MHW Builder",
    "directories": {
      "output": "release"
    },
    "artifactName": "MHW-Builder-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Almadeios",
      "repo": "MHWBuilder-Desktop",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
